# ============================================================
# Variáveis de ambiente do projeto (.env.example)
# ============================================================
# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).
# ============================================================

# Porta onde o servidor vai rodar (http://localhost:3000)
PORT=3000

# Chave secreta usada para assinar e validar o token JWT.
# Troque por um texto longo e difícil de adivinhar.
JWT_SECRET=troque-por-um-segredo-forte
